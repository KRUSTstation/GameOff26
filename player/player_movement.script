local SPEED = 90
local ROLL_SPEED = 130
local ROLL_TIME = 0.8
local GRAVITY = -900
local JUMP_SPEED = 280
local MAX_FALL = -500

local GROUND = hash("ground")

function init(self)
	msg.post(".", "acquire_input_focus")
	self.velocity = vmath.vector3()
	self.left = false
	self.right = false
	self.rolling = false
	self.grounded = false
	self.correction = vmath.vector3()
	self.current_anim = nil
	self.facing_left = false
	self.push_x = 0
end

local function play(self, anim)
	if self.current_anim ~= anim then
		self.current_anim = anim
		sprite.play_flipbook("#sprite", hash(anim))
	end
end

function update(self, dt)
	local dir = 0
	if self.left then dir = dir - 1 end
	if self.right then dir = dir + 1 end

	if self.grounded and self.velocity.y <= 0 then
		self.push_x = 0
	end

	if not self.grounded then
		self.velocity.x = math.min(self.velocity.x + dir * 0.5, SPEED)
	else
		local move_speed = self.rolling and ROLL_SPEED or SPEED
		self.velocity.x = dir * move_speed + self.push_x
	end

	if (self.wall_left and self.velocity.x < 0) or (self.wall_right and self.velocity.x > 0) then
		self.velocity.x = 0
	end

	self.velocity.y = math.max(self.velocity.y + GRAVITY * dt, MAX_FALL)

	go.set_position(go.get_position() + self.velocity * dt)

	if dir ~= 0 then
		local face_left = dir < 0
		if face_left ~= self.facing_left then
			self.facing_left = face_left
			sprite.set_hflip("#sprite", face_left)
		end

		if self.rolling then
			play(self, "roll")
		else
			play(self, "run")
		end

	else
		play(self, "idle")
	end

	self.correction = vmath.vector3()
	self.grounded = false
	self.wall_left = false
	self.wall_right = false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") and message.group == GROUND then
		local n = message.normal

		if message.distance > 0 then
			local proj = vmath.project(self.correction, n * message.distance)
			if proj < 1 then
				local comp = (message.distance - message.distance * proj) * n
				go.set_position(go.get_position() + comp)
				self.correction = self.correction + comp
			end
		end

		if n.y > 0.7 then
			self.grounded = true
			if self.velocity.y < 0 then self.velocity.y = 0 end

		elseif n.y < -0.7 then
			if self.velocity.y > 0 and not (self.wall_left or self.wall_right) then
				self.velocity.y = 0
			end

		elseif n.x > 0.7 then
			self.wall_left = true
		elseif n.x < -0.7 then
			self.wall_right = true
		end

	elseif message_id == hash("apply_player_force")	then
		self.velocity.y = message.force.y
		self.push_x = message.force.x
		self.grounded = false
	end
end

function on_input(self, action_id, action)
	if self.rolling then return end
	
	if action_id == hash("left") then
		self.left = not action.released
	elseif action_id == hash("right") then
		self.right = not action.released
	elseif action_id == hash("jump") and action.pressed and self.grounded and not self.rolling then
		self.velocity.y = JUMP_SPEED
	elseif action_id == hash("roll") and self.grounded and not self.rolling then
		if vmath.length(self.velocity) == 0 then return end
		
		self.rolling = true

		timer.delay(ROLL_TIME, false, function()
			self.rolling = false

			self.left = false
			self.right = false
		end)
	end
end

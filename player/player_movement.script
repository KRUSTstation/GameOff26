local SoundService = require "modules.soundservice"

go.property("facing_left", false)

local SPEED = 90 -- max speed
local ROLL_SPEED = 130
local ROLL_TIME = 0.8
local GRAVITY = -900
local JUMP_SPEED = 280
local MAX_FALL = -500
local X_DECAY = 50 -- air resistance basically
local X_MOVEMENT_DECAY = 100 -- when moving in the air

local WALK_SOUND_COOLDOWN = 0.3

local GROUND = hash("terrain")

function init(self)
	msg.post(".", "acquire_input_focus")
	self.allow_movement = false
	
	self.velocity = vmath.vector3()
	self.correction = vmath.vector3()
	
	self.left = false
	self.right = false
	self.rolling = false
	self.grounded = false
	self.facing_left = false

	self.walk_sound_cd = false
	self.current_anim = nil

	msg.post("main:/loader#level_loader", "register_player")
end

local function play(self, anim)
	if self.current_anim ~= anim then
		self.current_anim = anim
		sprite.play_flipbook("#sprite", hash(anim))
	end
end

function update(self, dt)
	-- movement math
	local dir = 0
	if self.left then dir = dir - 1 end
	if self.right then dir = dir + 1 end

	if not self.grounded then
		if dir ~= 0 and math.abs(self.velocity.x) <= SPEED then
			self.velocity.x = self.velocity.x + dir * X_MOVEMENT_DECAY * dt
		end
		
		if math.abs(self.velocity.x) > SPEED then
			if self.velocity.x < 0 then
				self.velocity.x = self.velocity.x + (X_DECAY * dt)
			else
				self.velocity.x = self.velocity.x - (X_DECAY * dt)
			end
		end
	else
		local move_speed = self.rolling and ROLL_SPEED or SPEED
		self.velocity.x = dir * move_speed
	end

	if (self.wall_left and self.velocity.x < 0) or (self.wall_right and self.velocity.x > 0) then
		self.velocity.x = 0
	end

	self.velocity.y = math.max(self.velocity.y + GRAVITY * dt, MAX_FALL)

	go.set_position(go.get_position() + self.velocity * dt)

	-- animations
	if dir ~= 0 then
		local face_left = dir < 0
		if face_left ~= self.facing_left then
			self.facing_left = face_left
			sprite.set_hflip("#sprite", face_left)
		end

		if self.rolling then
			play(self, "roll")
		else
			play(self, "run")
		end

	else
		play(self, "idle")
	end

	-- sounds
	if not self.walk_sound_cd and dir ~= 0 and self.walking_sound == nil and self.grounded then
		SoundService.play_random_sound_from_group("walk_wood")
		self.walk_sound_cd = true
		timer.delay(WALK_SOUND_COOLDOWN, false, function(self) self.walk_sound_cd = false end)
	end

	self.correction = vmath.vector3()
	self.was_grounded = self.grounded
	self.grounded = false
	self.wall_left = false
	self.wall_right = false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") and message.group == GROUND then
		local n = message.normal
		local dist = message.distance
		
		local limit = self.was_grounded and 0.7 or 0.9
		local is_floor = n.y > limit
		local is_ceiling = n.y < -limit

		if is_floor and self.velocity.y > 0 then return end

		if not is_floor and not is_ceiling then
			dist = dist / math.abs(n.x)
			n = vmath.vector3(n.x > 0 and 1 or -1, 0, 0)
		end

		if dist > 0 then
			local proj = vmath.project(self.correction, n * dist)
			if proj < 1 then
				local comp = (dist - dist * proj) * n
				go.set_position(go.get_position() + comp)
				self.correction = self.correction + comp
			end
		end

		if is_floor then
			self.grounded = true
			if self.velocity.y < 0 then self.velocity.y = 0 end
		elseif is_ceiling then
			if self.velocity.y > 0 and not (self.wall_left or self.wall_right) then
				self.velocity.y = 0
			end
		elseif n.x > 0 then
			self.wall_left = true
		else
			self.wall_right = true
		end

	elseif message_id == hash("apply_player_force") then
		self.velocity.y = message.force.y
		self.velocity.x = message.force.x
		self.grounded = false

	elseif message_id == hash("allow_movement") then
		self.allow_movement = true
	end
end

function on_input(self, action_id, action)
	if not self.allow_movement then return end
	if self.rolling then return end
	
	if action_id == hash("left") then
		self.left = not action.released
	elseif action_id == hash("right") then
		self.right = not action.released
	elseif action_id == hash("jump") and action.pressed and self.grounded and not self.rolling then
		self.velocity.y = JUMP_SPEED
	elseif action_id == hash("roll") and self.grounded and not self.rolling then
		if vmath.length(self.velocity) == 0 then return end
		
		self.rolling = true

		timer.delay(ROLL_TIME, false, function()
			self.rolling = false

			self.left = false
			self.right = false
		end)
	end
end

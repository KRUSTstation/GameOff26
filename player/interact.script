local Json = require "modules.json"
local TableHelper = require "modules.table_helper"

local LevelData = Json.load_file("level_data")
local ItemData = Json.load_file("item_data")

local INTERACTABLE = hash("item_interactable")
local MAX_SPEED = 90
local MAX_ROTATION_SPEED = 5
local Y_OFFSET = 5

function init(self)
	msg.post(".", "acquire_input_focus")
	
	self.energy_used = 0
	self.max_energy = 0

	self.items = {}
end

function update(self, dt)
	if #self.items == 0 then return end

	local player_pos = go.get_position()
	local y_offset = 0

	for _, item in ipairs(self.items) do
		local item_sprite = msg.url(nil, item, "sprite")
		local item_size = vmath.mul_per_elem(go.get(item_sprite, "size"), go.get(item_sprite, "scale"))

		local facing_left = go.get("#player_movement", "facing_left")
		local facing_dir = facing_left and 1 or -1

		-- Position
		local target_pos = player_pos + vmath.vector3((item_size.x + 3) * facing_dir, y_offset, 1)
		local item_pos = go.get_position(item)

		local to_target = target_pos - item_pos
		local dist = vmath.length(to_target)
		local step = MAX_SPEED * dt

		if dist <= step then
			go.set_position(target_pos, item)
		elseif dist > 0 then
			go.set_position(item_pos + (to_target / dist) * step, item)
		end

		-- Rotation
		local current_rot = go.get_rotation(item)
		local target_rot = vmath.quat()

		local new_rot = vmath.slerp(dt * MAX_ROTATION_SPEED, current_rot, target_rot)
		go.set_rotation(new_rot, item)

		y_offset = y_offset + Y_OFFSET + item_size.y
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") and message.group == INTERACTABLE then
		local id = message.other_id

		if TableHelper.contains(self.items, id) then return end
		
		local item_type = go.get(msg.url(nil, id, "item"), "item_type")

		local data = ItemData[item_type]
		local new_energy = self.energy_used + data.energy

		if new_energy <= self.max_energy then
			self.energy_used = new_energy
			table.insert(self.items, id)
			msg.post(msg.url(nil, id, "collisionobject"), "disable")
		end

	elseif message_id == hash("set_energy_levels") then
		local level_data = LevelData[message.level].phases[message.phase]
		
		self.max_energy = level_data.max_energy

		self.energy_used = 0
		self.items = {}
	end
end

function on_input(self, action_id, action)
	if action_id == hash("drop") and action.pressed and #self.items > 0 then
		local id = table.remove(self.items, #self.items)
		local item_type = go.get(msg.url(nil, id, "item"), "item_type")

		msg.post(msg.url(nil, id, "collisionobject"), "enable")
		self.energy_used = self.energy_used - ItemData[item_type].energy
	end
end
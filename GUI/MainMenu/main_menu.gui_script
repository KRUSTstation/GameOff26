local druid = require "druid.druid"

local function lvl1b_callback()
	msg.post("#", "disable")
	msg.post("/loader", "load_level", {level = "01"})
end

function init(self)
	self.druid = druid.new(self)
	self.lvl1b = self.druid:new_button("load_level_1", lvl1b_callback)
end

function update(self, dt)
	local background = gui.get_node("background")

	local width = gui.get_width()
	local height = gui.get_height()

	local centre = vmath.vector3(width / 2, height / 2, 0)
	gui.set_size(background, vmath.vector3(width, height, 0))
	gui.set_position(background, centre)

	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	if action_id == hash("click") and action.pressed then
		local lvl1b = gui.get_node("load_level_1")
		if gui.pick_node(lvl1b, action.x, action.y) then
			msg.post("#", "disable")
			msg.post("/loader", "load_level", {level = "01"})
		end
	end
end

function final(self)
	self.druid:final()
end
local Camera = require "modules.camera"

local LERP_SMOOTH = 0.1
local ZOOM = 1.7

function init(self)
	msg.post("#camera", "acquire_camera_focus")
	go.set("#camera", "orthographic_zoom", ZOOM)
	
	self.camera = Camera.new(go.get_id())
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_target") then
		self.camera:follow(message.target, { lerp = LERP_SMOOTH , bounds = message.bounds })
	end
end

function update(self, dt)
	self.camera:update()
end
local Json = require "modules.json"
local LevelData = Json.load_file("level_data")

local function proxy_url(level, phase)
	return "main:/" .. level .. "#" .. level .. "_p" .. phase
end

local function level_object(level)
	return "main:/" .. level
end

function init(self)
	msg.post(".", "acquire_input_focus")
	
	self.level_loaded = nil
	self.phase = nil
	self.pending_phase = nil
	self.player_url = nil
	self.loading_done = false
	self.max_phase = nil
end

local function try_release_player(self)
	if self.loading_done and self.player_url then
		msg.post("/GUI#loading", "disable")
		msg.post(self.player_url, "allow_movement")
		
		local interact = msg.url(self.player_url.socket, self.player_url.path, "interact")
		msg.post(interact, "set_energy_levels", { level = self.level_loaded, phase = self.phase })
	end
end

local function start_loading(self)
	self.player_url = nil
	self.loading_done = false

	msg.post("/GUI#loading", "enable")
	msg.post(proxy_url(self.level_loaded, self.phase), "load")
	timer.delay(2, false, function()
		self.loading_done = true
		try_release_player(self)
	end)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "init")
		msg.post(sender, "enable")

	elseif message_id == hash("register_player") then
		self.player_url = sender
		try_release_player(self)

	elseif message_id == hash("proxy_unloaded") then
		self.player_url = nil
		if self.pending_phase then
			self.phase = self.pending_phase
			self.pending_phase = nil
			start_loading(self)
		end

	elseif message_id == hash("load_level") then
		self.level_loaded = message.level
		self.phase = 1
		self.max_phase = #LevelData[self.level_loaded].phases
		
		msg.post(level_object(self.level_loaded), "acquire_input_focus")
		start_loading(self)

	elseif message_id == hash("load_next_phase") and self.level_loaded and self.phase < self.max_phase then
		self.pending_phase = self.phase + 1
		
		msg.post(proxy_url(self.level_loaded, self.phase), "unload")

	elseif message_id == hash("unload_level") and self.level_loaded then
		msg.post(proxy_url(self.level_loaded, self.phase), "unload")
		msg.post(level_object(self.level_loaded), "release_input_focus")
		
		self.level_loaded = nil
		self.phase = nil
		self.pending_phase = nil
		self.max_phase = nil

	elseif message_id == hash("finish_level") then
		msg.post("/loader", "unload_level")
		msg.post("/GUI#main_menu", "enable")
	end
end
go.property("force", 600)
go.property("angle", 45) -- in degree

function init(self)
	
end

function on_message(self, message_id, message, sender)
	if message_id == hash("collision_response") and message.other_group == hash("player") then
		local v = vmath.vector3(1 / math.atan(self.angle), 1, 1)
		v = (v / vmath.length(v)) * self.force

		msg.post(message.other_id, "apply_player_force", { force = self.force })
	end
end